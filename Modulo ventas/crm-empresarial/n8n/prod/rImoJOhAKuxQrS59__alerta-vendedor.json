      "name": "Reabrir+etiquetar CRM",
      "parameters": {
        "jsCode": "// La bandeja vive en el CRM propio; ya no se avisa a Chatwoot.\nconst b = $input.first().json.body || {};\nconst wa = String(b.wa_id || '').replace(/[^0-9]/g, '');\nconst nombre = b.nombre || '';\nconst negocio = b.negocio || '';\nconst convId = null;\n\nlet quien = nombre ? nombre : 'un cliente';\nif (negocio) quien += ' de ' + negocio;\nconst texto = '🔔 *Lead pide atención*\\n' + quien + ' quiere hablar con un vendedor.\\n\\n👉 Responder ahora: https://wa.me/' + wa + '\\n👉 Ver en el CRM: https://agente.appcadabra.cl/crm/conversaciones';\n\n// Un solo item: el nodo Postgres siguiente lee los vendedores.\nreturn [{ json: { convId, texto, wa } }];"
