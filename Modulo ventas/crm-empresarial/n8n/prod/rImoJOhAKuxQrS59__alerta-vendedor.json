      "name": "Armar items por vendedor",
      "parameters": {
        "jsCode": "const prev = $('Reabrir+etiquetar CRM').first().json;\nconst vends = $input.all().map(i => String(i.json.whatsapp || '').replace(/[^0-9]/g,'')).filter(Boolean);\nif (vends.length === 0) return [{ json: { sin_vendedores: true, convId: prev.convId } }];\nreturn vends.map(v => ({ json: { convId: prev.convId, texto: prev.texto, vendedor: v } }));"
      },
