    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst value = body?.entry?.[0]?.changes?.[0]?.value ?? {};\nconst msg = value.messages?.[0] ?? {};\nconst metadata = value.metadata ?? {};\nlet userMessage = msg.text?.body ?? '';\nif (msg.type === 'interactive') {\n  const inter = msg.interactive ?? {};\n  userMessage = inter.button_reply?.id || inter.list_reply?.id || inter.button_reply?.title || inter.list_reply?.title || '';\n}\nreturn [{ json: { from: msg.from ?? null, phone_number_id: metadata.phone_number_id ?? null, user_message: userMessage, message_id: msg.id ?? null } }];"
      },
