    {
      "parameters": {
        "jsCode": "const meta = $('Extraer media').first().json;\nconst texto = ($input.first().json.text || '').trim();\nconst nombre = meta.filename || 'documento';\nlet user_message;\nif (texto) { user_message = '[El cliente envió un DOCUMENTO (' + nombre + '). Contenido extraído: ' + texto.slice(0,4000) + ']'; }\nelse { user_message = '[El cliente envió un DOCUMENTO (' + nombre + ') pero no pude extraer texto (PDF escaneado). Pídele que lo mande como foto o que escriba lo que necesita.]'; }\nconst caption = (meta.caption || '').trim();\nif (caption) user_message += '\\nTexto del cliente: ' + caption;\nreturn [{ json: { from: meta.from, phone_number_id: meta.phone_number_id, user_message, message_id: meta.message_id } }];"
      },
