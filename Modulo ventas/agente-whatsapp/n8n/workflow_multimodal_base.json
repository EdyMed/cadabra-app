    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const b64 = $binary.data.data;\n  const mime = $('Extraer media').first().json.mime_type || 'image/jpeg';\n  const caption = $('Extraer media').first().json.caption || '';\n  const instruccion = 'Describe en español de forma útil qué muestra esta imagen para poder atender al cliente por WhatsApp. Si es un producto, di qué producto parece. Si es un documento, transcribe su texto e ítems. Sé conciso.' + (caption ? (' El cliente escribió junto a la imagen: \\\"' + caption + '\\\".') : '');\n  return JSON.stringify({ model: 'gpt-4o', messages: [{ role: 'user', content: [ { type: 'text', text: instruccion }, { type: 'image_url', image_url: { url: 'data:' + mime + ';base64,' + b64 } } ] }], max_tokens: 500 });\n})() }}",
        "options": {}
      },
