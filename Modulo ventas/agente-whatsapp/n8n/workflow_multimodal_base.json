      "parameters": {
        "jsCode": "const meta = $('Extraer media').first().json;\nconst lectura = $input.first().json?.choices?.[0]?.message?.content?.trim() || '(no pude leer la imagen)';\nconst caption = (meta.caption || '').trim();\nconst user_message = '[El cliente envió una IMAGEN. Lectura automática: ' + lectura + ']' + (caption ? ('\\nTexto del cliente: ' + caption) : '');\nreturn [{ json: { from: meta.from, phone_number_id: meta.phone_number_id, user_message, message_id: meta.message_id } }];"
      },
