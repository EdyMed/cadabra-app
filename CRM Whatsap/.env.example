# ===== URL pública del panel (usada para construir links de email, ej. reset-password) =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Supabase (Login / Auth) =====
# Del panel de Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://ukliarmrqqtdyrpbnohg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega_aqui_la_anon_key
# service_role SOLO server-side (nunca en el cliente). Usada para seed/mapeo si hace falta.
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_la_service_role_key

# ===== Postgres de NocoDB (datos de leads, SOLO LECTURA) =====
# Usuario de solo lectura tipo metabase_ro (crear dash_ro con SELECT en schema p14vch8or5d3r3s)
NOCODB_PG_HOST=localhost        # en local: túnel o IP; en EasyPanel: nocodb-db
NOCODB_PG_PORT=5432
NOCODB_PG_DATABASE=appcadabra
NOCODB_PG_USER=dash_ro
NOCODB_PG_PASSWORD=pega_aqui_la_password
NOCODB_PG_SCHEMA=p14vch8or5d3r3s
# ssl: 'require' en remoto, 'disable' si es conexion interna sin TLS
NOCODB_PG_SSL=disable

